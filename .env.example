# Copy to .env and adjust. All are optional.

# Encryption key for stored secrets (Qobuz token, Jellyfin key, admin hash).
# Generate: openssl rand -base64 32 | tr '+/' '-_'
SECRET_KEY=

# Timezone for the scheduler / timestamps.
TZ=Europe/Berlin

# Host paths for the two volumes. Point MUSIC_DIR at your library / NAS share.
# Both must be writable by the PUID/PGID below.
# CONFIG_DIR=./config
# MUSIC_DIR=/srv/media/music

# Run the container as this host user so files aren't root-owned and writes to a
# media share succeed. Find yours with `id <user>` (e.g. your Jellyfin/media user).
# Leave unset to run as root (0:0).
# PUID=1000
# PGID=1000

# Web UI port on the host.
# PORT=8080

# You can pre-seed these instead of using the web UI (optional):
# QOBUZ_QUALITY=27          # 27=Hi-Res<=192k, 7=Hi-Res<=96k, 6=FLAC CD, 5=MP3 320
# QOBUZ_SYNC_INTERVAL_HOURS=6
# JELLYFIN_URL=http://jellyfin:8096
# JELLYFIN_API_KEY=
